# Copy to .env and adjust. Read by compose.yaml and by settings.py (via plain os.environ,
# so `set -a; source .env; set +a` before manage.py commands, or use direnv/uv run --env-file).
POSTGRES_DB=trading_journal
POSTGRES_USER=trading_journal
POSTGRES_PASSWORD=trading_journal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
