# Copy to .env and adjust. Read by compose.yaml and by settings.py (via plain os.environ,
# so `set -a; source .env; set +a` before manage.py commands, or use direnv/uv run --env-file).
POSTGRES_DB=trading_journal
POSTGRES_USER=trading_journal
POSTGRES_PASSWORD=trading_journal
# 127.0.0.1, not localhost: compose publishes on IPv4 only, and localhost can resolve to ::1
# first (seen on Windows), which makes every DB connection hang with no error.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Any real value works in dev (DJANGO_DEBUG=true below), since settings.py falls back to
# its own dev-only default when this is unset. In prod (DJANGO_DEBUG=false), this line
# MUST be replaced with a real secret (e.g. `python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())"`) — settings.py refuses
# to start with this exact placeholder value, so ops can't accidentally deploy with it
# still in place, but the placeholder is spelled out unmistakably here regardless.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=CHANGE-ME-run-get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
